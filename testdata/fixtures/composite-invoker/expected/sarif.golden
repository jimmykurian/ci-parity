{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p001/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the task runner does not define."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p002/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task the task runner marks internal, private or hidden."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p003/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p004/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p005/",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task biuld' is not defined in Taskfile.yml (closest: build)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 17
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "5e4f9ea8abb13e46989e2b9ce8ab7d50"
          }
        },
        {
          "ruleId": "P003",
          "level": "error",
          "message": {
            "text": "'setup' is marked internal: true and should not be invoked from CI"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 23
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "953ba6b8c6b13ba263477bca242f3221"
          }
        },
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task lnt' is not defined in Taskfile.yml (closest: lint)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
                  "startColumn": 17
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "e2783b09a7990cd682b87d8ba422ac4f"
          }
        }
      ]
    }
  ]
}
