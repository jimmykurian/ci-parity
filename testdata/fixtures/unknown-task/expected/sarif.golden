{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the Taskfile does not define."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task marked internal: true."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task lint:all' is not defined in Taskfile.yml (closest: lint:ci)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 19
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "694bd3f0d849da83f6510f2947988c97"
          }
        },
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task test' is not defined in Taskfile.yml (closest: test:unit)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 19
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "838d718b3ad04e25714a0a978fcdde15"
          }
        },
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task publish-docs' is not defined in Taskfile.yml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 19
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "aad8744beb4ec446e31090c8c178a309"
          }
        },
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'task tset:unit' is not defined in Taskfile.yml (closest: test:unit)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 27
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "63ceb0c3ac689644f8a227e8d4045349"
          }
        }
      ]
    }
  ]
}
