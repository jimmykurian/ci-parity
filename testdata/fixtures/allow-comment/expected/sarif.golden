{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the Taskfile does not define."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task marked internal: true."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Publish\" in job \"release\" runs 'docker push widget-service' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "2f8d104eca7ae84384f700fe332a2c19"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "images publish only from CI"
            }
          ]
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Publish\" in job \"release\" runs 'docker login ghcr.io' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 11,
                  "startColumn": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "4b5ba7cdf83f1c40a687a82e6fd13c5a"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "the registry login has no local equivalent"
            }
          ]
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Publish\" in job \"release\" runs 'docker logout ghcr.io' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "c239027d6f0354b0eef2f17e75b3dbd6"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Missing reason\" in job \"release\" runs 'pnpm publish' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "45e12baf8e0b4c35734353ad45792a6f"
          }
        },
        {
          "ruleId": "P005",
          "level": "warning",
          "message": {
            "text": "allow comment has no reason"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 27
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "59e41a21e7e8230a620dc5b77aaaea0a"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"One-line allow\" in job \"release\" runs 'docker push widget-service:edge' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "6bcf3c74a60e4c055c69a3fde50ba3e3"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "edge images publish from CI"
            }
          ]
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Quoted one-line allow\" in job \"release\" runs 'npm publish' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
                  "startColumn": 15
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "e25a1fc07d01428be028466922d66864"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "package publish needs the CI token"
            }
          ]
        }
      ]
    }
  ]
}
