::error file=.github/workflows/ci.yml,line=9,col=14,title=P001 inline-tool::step "Install" in job "web" runs 'pnpm install --frozen-lockfile' directly
::error file=.github/workflows/ci.yml,line=11,col=14,title=P001 inline-tool::step "Test" in job "web" runs 'npx vitest run' directly
::error file=.github/workflows/ci.yml,line=12,col=14,title=P001 inline-tool::step 4 in job "web" runs './gradlew check' directly
::error file=.github/workflows/ci.yml,line=14,col=14,title=P001 inline-tool::step "Lint" in job "web" runs 'pnx eslint .' directly
::error file=.github/workflows/ci.yml,line=19,col=14,title=P001 inline-tool::step "Image" in job "api" runs 'docker build -t example-api .' directly
::error file=.github/workflows/ci.yml,line=21,col=14,title=P001 inline-tool::step "Pytest" in job "api" runs 'python3 -m pytest' directly
::error file=.github/workflows/deploy.yaml,line=8,col=14,title=P001 inline-tool::step "Plan" in job "deploy" runs 'tofu plan -out plan.bin' directly
::error file=.github/workflows/deploy.yaml,line=10,col=14,title=P001 inline-tool::step "Apply via make" in job "deploy" runs 'make deploy' directly
