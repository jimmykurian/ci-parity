{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p001/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the task runner does not define."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p002/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task the task runner marks internal, private or hidden."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p003/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p004/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p005/",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P004",
          "level": "error",
          "message": {
            "text": ".github/workflows/ci.yml is locked at 0 and has 3 inline-tool findings"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "6fef97529d57d8d285663223d48c3bf3"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Install\" in job \"web\" runs 'pnpm install' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "3bd308320564baac08e4a1e51ed1d569"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Test\" in job \"web\" runs 'pnpm test' directly; already available as 'task test'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "6080425895b5f464ba71e41be2c8c205"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Lint\" in job \"web\" runs 'pnpm lint' directly; already available as 'task lint'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "e8566e60124a3b88baca82dc995d20f3"
          }
        },
        {
          "ruleId": "P001",
          "level": "note",
          "message": {
            "text": "step \"Within its baseline\" in job \"e2e\" runs 'pnpm exec playwright test' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/nightly.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "0c640f66bb537a4b522260a24c661193"
          }
        },
        {
          "ruleId": "P004",
          "level": "error",
          "message": {
            "text": ".github/workflows/release.yml is locked at 0 and has 1 inline-tool findings"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "a8f9c20c6a0c6ae1919b9282c60f464b"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Not in the baseline, so locked\" in job \"publish\" runs 'npm publish' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "4663e2070c1706890fa3dba00f7c0123"
          }
        }
      ]
    }
  ]
}
