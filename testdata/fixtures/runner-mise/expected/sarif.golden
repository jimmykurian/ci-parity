{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p001/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the task runner does not define."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p002/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task the task runner marks internal, private or hidden."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p003/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p004/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p005/",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Inline test\" in job \"ci\" runs 'go test ./...' directly; already available as 'mise run test'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "a49c27868936e49efe9ded555810f815"
          }
        },
        {
          "ruleId": "P002",
          "level": "error",
          "message": {
            "text": "'mise run tset' is not defined in mise.toml (closest: test)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 23
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "ad33bdcc1cdecd2d7852e9dfb28d3012"
          }
        },
        {
          "ruleId": "P003",
          "level": "error",
          "message": {
            "text": "'release' is hidden and should not be invoked from CI"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
                  "startColumn": 23
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "b0ab7dd5ee4c29e9f879fd81fbb9f051"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Through just\" in job \"ci\" runs 'just build' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 22,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "4488aec5bb678f6f7d32168a8d7afe20"
          }
        }
      ]
    }
  ]
}
