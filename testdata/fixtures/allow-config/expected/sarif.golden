{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p001/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the task runner does not define."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p002/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task the task runner marks internal, private or hidden."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p003/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p004/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://jimmykurian.github.io/ci-parity/rules/p005/",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Push image from the wrong workflow\" in job \"build\" runs 'docker push ghcr.io/acme/widget-service:dev' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "dc5a494f3caf3837778090e04e3a1f08"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Check registry\" in job \"build\" runs 'npm view acme-app version' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "5d4e47478a408f1ed3e826a805e0e9ca"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "read-only registry lookups"
            }
          ]
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Push image\" in job \"publish\" runs 'docker push ghcr.io/acme/widget-service:1.0.0' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "bb15a5a52c1fa91ff8b0c97236f567d5"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "images publish only from the release workflow"
            }
          ]
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Check registry\" in job \"publish\" runs 'npm view acme-app version' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "e2bce7036ab7d547addf3d5878a14eb2"
          },
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "read-only registry lookups"
            }
          ]
        }
      ]
    }
  ]
}
