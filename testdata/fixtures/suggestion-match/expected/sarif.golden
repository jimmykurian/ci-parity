{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the Taskfile does not define."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task marked internal: true."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://github.com/jimmykurian/ci-parity#rules",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Exact match, internal duplicate is skipped\" in job \"web\" runs 'pnpm test' directly; already available as 'task test'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "780f2aaf9b5b422126e45badb8e9d0dc"
          }
        },
        {
