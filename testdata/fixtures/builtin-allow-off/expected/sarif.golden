{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ci-parity",
          "version": "dev",
          "informationUri": "https://github.com/jimmykurian/ci-parity",
          "rules": [
            {
              "id": "P001",
              "name": "inline-tool",
              "shortDescription": {
                "text": "A run: step calls a listed tool directly instead of through the task runner."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p001/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P002",
              "name": "unknown-task",
              "shortDescription": {
                "text": "CI calls a task that the task runner does not define."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p002/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P003",
              "name": "internal-task",
              "shortDescription": {
                "text": "CI calls a task the task runner marks internal, private or hidden."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p003/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P004",
              "name": "regression",
              "shortDescription": {
                "text": "A workflow has more inline-tool findings than its baseline allows."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p004/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "P005",
              "name": "unsupported",
              "shortDescription": {
                "text": "A step that ci-parity cannot analyze."
              },
              "helpUri": "https://ci-parity.is-a.dev/rules/p005/",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Version\" in job \"acme-app\" runs 'go version' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "1ce7f7043898b12bfdb1000d526d5cac"
          }
        },
        {
          "ruleId": "P001",
          "level": "error",
          "message": {
            "text": "step \"Sign in\" in job \"acme-app\" runs 'docker login ghcr.io' directly"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "ciParity/v1": "7808ee00d4d2ec2031d0214c94713776"
          }
        }
      ]
    }
  ]
}
