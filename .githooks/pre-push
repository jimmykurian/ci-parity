set -eo pipefail

# Refuses pushes to main (and deleting it), then runs the tests and the self-check
# when the pushed commits change Go code, fixtures, the module, the Taskfile, the
# workflows or this repo's ci-parity config. They run on the working tree, so the
# pushed commit must be the clean checkout. Without Go or task the run is skipped
# with a warning; CI runs it anyway. Install with `task hooks:install`. Skip once
# with `git push --no-verify`.

cd "$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
CHANGED=""
# Pushed commits other than HEAD, which the working tree doesn't hold.
OTHER=""

while read -r _local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: main takes changes only through pull requests. Push a branch and open a PR,"
    echo "or bypass once with git push --no-verify."
    exit 1
  fi
  # Branch deletions push nothing to test.
  [[ "$local_sha" == "$ZERO" ]] && continue
  if [[ "$local_sha" != "$(git rev-parse HEAD)" ]]; then OTHER+="${remote_ref#refs/heads/} "; fi
  if [[ "$remote_sha" == "$ZERO" ]]; then
    # A new branch: everything since it left main.
    CHANGED+="$(git diff --name-only "origin/main...$local_sha")"$'\n'
  else
    CHANGED+="$(git diff --name-only "$remote_sha..$local_sha")"$'\n'
  fi
done

if ! grep -qE '\.go$|^go\.(mod|sum)$|^testdata/|^Taskfile\.yml$|^\.github/workflows/|^\.ci-parity' <<< "$CHANGED"; then
  exit 0
fi

for tool in go task; do
  if ! command -v "$tool" > /dev/null; then
    echo "pre-push: tests skipped ($tool not installed)"
    exit 0
  fi
done

DIRTY="$(git status --porcelain)"
if [[ -n "$OTHER" || -n "$DIRTY" ]]; then
  [[ -n "$OTHER" ]] && echo "pre-push: pushing ${OTHER% }, which isn't the checked-out commit."
  [[ -n "$DIRTY" ]] && echo "pre-push: uncommitted changes:" && echo "$DIRTY"
  echo "The tests would check different code from the push. Check out the branch, or commit"
  echo "or stash the changes (git stash -u), then push again; or skip once with --no-verify."
  exit 1
fi

FAILED=0
task test || { echo "pre-push: tests failed"; FAILED=1; }
task self-check || { echo "pre-push: self-check failed"; FAILED=1; }
exit "$FAILED"
