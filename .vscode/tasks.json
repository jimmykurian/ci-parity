{
  // Every check is in Taskfile.yml, and the Task extension lists them. These two make
  // `task build` and `task test` the default build and test tasks (Run Build Task, Run Test
  // Task), and let launch configurations build first.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "task build",
      "type": "shell",
      "command": "task build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "task test",
      "type": "shell",
      "command": "task test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    }
  ]
}
