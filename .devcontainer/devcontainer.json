// A container with Go at the toolchain go.mod pins and every tool in mise.toml.
// Works in VS Code and GitHub Codespaces.
{
  "name": "ci-parity",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      // The same list as .vscode/extensions.json.
      "extensions": [
        "golang.go",
        "task.vscode-task",
        "hverlin.mise-vscode",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-mermaid",
        "timonwong.shellcheck",
        "tekumara.typos-vscode",
        "editorconfig.editorconfig"
      ]
    }
  }
}
